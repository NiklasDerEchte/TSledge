{
  "author": "Niklas Wockenfuß",
  "url": "https://niklaswockenfuss.de/",
  "email": "wockenfussnik@gmail.com",
  "homepage": "https://github.com/NiklasDerEchte/TSledge/",
  "name": "tsledge",
  "version": "0.1.27",
  "license": "MIT",
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/wocke?utm_medium=unknown&utm_source=join_link&utm_campaign=creatorshare_creator&utm_content=copyLink"
    }
  ],
  "description": "My playground and some helpful tools for web development ",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "repl": "dist/bin/repl.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "esbuild:build": "npm i && node esbuild.js && tsc --emitDeclarationOnly",
    "esbuild:dev": "node --enable-source-maps ./dist/tests/main.js",
    "dev": "npm run esbuild:build && npm run esbuild:dev",
    "esbuild:build:watch": "node ./esbuild.js --watch",
    "esbuild:dev:watch": "node --enable-source-maps --watch ./dist/tests/main.js",
    "dev:watch": "npm run esbuild:build && concurrently \"npm run esbuild:build:watch\" \"npm run esbuild:dev:watch\"",
    "repl": "tsx ./bin/repl.ts",
    "npmjs": "npm run esbuild:build && npm publish",
    "package": "npm run esbuild:build && npm pack",
    "typedoc:build:api": "typedoc --options typedoc.json",
    "vitepress:build": "vitepress build docs",
    "docs:build": "npm run typedoc:build:api && npm run vitepress:build",
    "vitepress:watch": "vitepress dev docs",
    "docs:watch": "npm run typedoc:build:api && npm run vitepress:watch"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "tsledge-core": "^0.1.1"
  },
  "peerDependencies": {
    "mongoose": "9.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitepress": "^1.6.4"
  }
}